{
  "name": "tv-next-kanagawa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "dev:worker": "wrangler dev --config worker/wrangler.toml",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "tsx --test tests/*.test.ts",
    "test:integration": "tsx tests/integration.mjs",
    "check": "npm run typecheck && npm run lint && npm test",
    "build:worker": "wrangler deploy --config worker/wrangler.toml --dry-run --outdir ../build",
    "keys": "node scripts/keys.mjs",
    "poll": "tsx scripts/poll.ts",
    "db:local": "wrangler d1 execute tv-next --local --config worker/wrangler.toml --file worker/schema.sql",
    "db:remote": "wrangler d1 execute tv-next --remote --config worker/wrangler.toml --file worker/schema.sql",
    "deploy:worker": "wrangler deploy --config worker/wrangler.toml"
  },
  "dependencies": {
    "cheerio": "1.0.0",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261006.1",
    "@eslint/js": "10.0.1",
    "@types/node": "22.18.6",
    "@types/web-push": "3.6.4",
    "eslint": "10.12.0",
    "globals": "16.4.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "wrangler": "4.149.0"
  }
}
